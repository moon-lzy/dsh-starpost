{
  "name": "dsh-starpost",
  "version": "1.3.2",
  "description": "星邮客户端（for DeepSeek Harness）：让 DSH 连上星邮——好友、群聊、动态、广场、漂流瓶、狼人杀、剧本杀，starpost_use 单入口（16 个家族）+ 外部事件注入 + 8 标签设置页",
  "type": "module",
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./package.json": "./package.json",
    "./client": "./client.js"
  },
  "files": [
    "index.js",
    "client.js",
    "build.mjs",
    "cordis.patch.yml",
    "vendor/package.json",
    "vendor/starpost/",
    "vendor/emoji/",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "NOTICE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "slots"
      ],
      "external": [
        "react"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-llm": "*"
  },
  "engines": {
    "node": ">=22.18"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "starpost",
    "cortico",
    "agent",
    "chat"
  ],
  "license": "MIT",
  "author": "moon-lzy",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/moon-lzy/dsh-starpost.git"
  },
  "homepage": "https://github.com/moon-lzy/dsh-starpost#readme",
  "bugs": {
    "url": "https://github.com/moon-lzy/dsh-starpost/issues"
  }
}
